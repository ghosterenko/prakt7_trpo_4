<Window x:Class="Konkov_prakt7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konkov_prakt7"
        mc:Ignorable="d"
        Title="Сотрудники" Height="650" Width="850"
        Background="{StaticResource BackgroundMain}">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Сотрудники" 
                   HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20"
                   FontWeight="Bold" Margin="20 0 0 0"/>
        
        
        <ListView x:Name="ListEmployes" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="20 0 0 0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id, StringFormat={}{0} номер}" FontSize="16"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullName}" FontSize="16"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Position}" FontSize="16"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Salary, StringFormat={}{0:N2} руб.}" FontSize="16"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HireDate, StringFormat={}{0:D}}" FontSize="16"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IsActiveStr}" FontSize="16"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="Позиция"/>
            <TextBox x:Name="TbPosition" Width="250" HorizontalAlignment="Left" TextChanged="TbPosition_TextChanged"/>
            
            <TextBlock Text="Минимальная зарплата"/>
            <TextBox x:Name="TbMinSalary" Width="250" HorizontalAlignment="Left" TextChanged="TbMinSalary_TextChanged" Text="0"/>

            <TextBlock Text="Номер человека"/>
            <TextBox Width="250" HorizontalAlignment="Left"/>

            <Button x:Name="AddBtn" Width="250"  Content="Добавить запись" Click="AddBtn_Click" HorizontalAlignment="Left" Margin="0 10 0 0"/>
            <Button x:Name="EditBtn" Width="250"  Content="Изменить запись" Click="EditBtn_Click" HorizontalAlignment="Left" Margin="0 10 0 0"/>
            <Button x:Name="DeleteBtn" Width="250" Content="Удалить запись" Click="DeleteBtn_Click" HorizontalAlignment="Left" Margin="0 10 0 0"/>
        </StackPanel>
        
    </Grid>
</Window>
