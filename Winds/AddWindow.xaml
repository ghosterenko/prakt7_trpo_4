<Window x:Class="Konkov_prakt7.Winds.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление сотрудника" Height="450" Width="800">
    <StackPanel x:Name="stpanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
        <TextBlock Text="ФИО" Margin="0 10 0 0"/>
        <TextBox Text="{Binding FullName, Mode=TwoWay}"/>

        <TextBlock Text="Позиция" Margin="0 10 0 0"/>
        <TextBox Text="{Binding Position, Mode=TwoWay}"/>

        <TextBlock Text="Зарплата" Margin="0 10 0 0"/>
        <TextBox Text="{Binding Salary, Mode=TwoWay}"/>

        <TextBlock Text="Дата найма" Margin="0 10 0 0"/>
        <DatePicker SelectedDate="{Binding HireDateDp, Mode=TwoWay}"/>

        <TextBlock Text="Активность" Margin="0 10 0 0"/>
        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Content="Активный"/>

        <Button x:Name="AddEditbtn" Content="Создать"
                Click="AddEditbtn_Click" Margin="0 20 0 0" Height="30"/>
    </StackPanel>
</Window>